# profi-worker: наружные настройки. Скопируй в .env и заполни нужное.
# Приоритет: переменные окружения процесса > .env > profile > дефолты в src/profi/config.py.
# Пустая строка = «не задано» (берётся следующий уровень конфигурации).
# В значениях не оставляй комментарии в той же строке — парсер их не срезает.
# Формат аккаунтов: один аккаунт = своя секция PROFI_* + свой файл
# accounts/<акк>.env (source'ится скриптами запуска).

# --- LLM (читает src/profi/llm/client.py) ---
LLM_PROVIDER=anthropic
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=GLM-5.3-Flash
LLM_FALLBACK_MODEL=GLM-5.3
# Альтернативные провайдеры (LLM_PROVIDER=glm|openai):
# GLM_API_KEY=
# GLM_API_KEY_2=            # второй ключ: авто-фолбэк при 429/лимите
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# OPENAI_API_KEY=

# --- Business profile: что продаёт анкета ---
# PROFI_PROFILE=info                                # profiles/info.toml
# PROFI_PROFILE=languages                           # English + Spanish одним профилем
# Старые настройки ниже остаются override'ами и нужны только для точечной настройки:
# PROFI_PERSONA=info                                # persona override; personas/<имя>.md
# PROFI_SUBJECTS=информатик,программирован          # subject override, через запятую
# PROFI_STOP_PATTERNS=                              # stop-pattern override, через запятую

# --- Flow ---
# PROFI_FAST_PATH=1                                 # (1) fresh order: открыть один раз ->
#                                                   # details -> LLM/fallback -> send в той же вкладке
#                                                   # 0 = rollback к details-only worker + autopilot

# --- Аккаунт и браузер (читает src/profi/config.py; дефолты в скобках) ---
# PROFI_CDP_PORT=9333                               # (9333) свой порт на аккаунт
# PROFI_RELOAD_MIN=45                               # (45) мин пауза цикла ленты, с
# PROFI_RELOAD_MAX=60                               # (60) макс пауза цикла ленты, с
# PROFI_CHROME_PROFILE=data/chrome-profiles/main    # (main) свой профиль на аккаунт;
#                                                   #   относительный путь — от корня проекта
# PROFI_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#                                                   # на VPS — scripts/browser/chrome-vps.sh
# PROFI_DB=data/profi.db                            # своя БД на аккаунт
# PROFI_RESPOND_MODE=pay                            # (pay) pay | commission
# PROFI_LOG_LEVEL=INFO                              # (INFO)
# PROFI_CHAT_EVERY=2                                # (3) чат-чек каждый N-й цикл воркера
# PROFI_WORK_HOURS=8,23                             # (8,23) единое рабочее окно;
#                                                   #   0,24 = круглосуточно
# PROFI_DAILY_SEND_LIMIT=3                          # (0) 0 = без дневного лимита
# PROFI_MAX_POSITION=20                             # (20) 0 = не проверять позицию
# PROFI_MAX_RESPONSE_PRICE=500                      # (500) 0 = без потолка цены отклика
